<!DOCTYPE html>
<html lang="en">
  <html>
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Back End</title>
      <link rel="icon" type="image/png" href="/images/mainLogoTitleBar.png" />
      <link rel="stylesheet" href="/css/recipeManagementBackEnd_style.css" />
    </head>

    <body>
      <div id="overlay"></div>
      <nav>
        <img class="teste" onclick="openNav()" src="/images/menuButton.png" />

        <a href="/"><img class="logo" src="/images/mainLogo.png" /></a>

        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/profile">Profile</a></li>
          <li><a href="/auth/logout">Logout</a></li>
        </ul>
      </nav>

      <div id="mySidenav" class="sidenav">
        <a href="javascript:void(0)" class="closebtn" onclick="closeNav()"
          >&times;</a
        >
        <a href="/backEnd">Dashboard</a>
        <a href="/userManagementBackEnd">User management</a>
        <a href="/recipeManagementBackEnd">Recipe management</a>
        <a href="/recipesForApprovalBackEnd">Recipes for Approval</a>
      </div>

      <div id="main">recipe managment</div>

      <script>
        document.addEventListener("DOMContentLoaded", () => {
          fetchData();
        });

        async function fetchData() {
          try {
            const response = await fetch("/api/api/recipes");
            if (!response.ok) {
              throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const recipes = await response.json();
            // Atualize o conteúdo da página com os dados recebidos do backend
            updateTable(recipes);
          } catch (error) {
            console.error("Error fetching data:", error);
          }
        }

        function updateTable(recipes) {
          const tableContainer = document.getElementById("main");
          tableContainer.innerHTML = "";

          if (recipes.length > 0) {
            const table = document.createElement("table");
            table.classList.add("recipes-table");

            const headerRow = document.createElement("tr");
            headerRow.innerHTML =
              "<th>ID</th><th>Title</th><th>Author</th><th>Ingredients</th><th>Preparetion</th><th>Category</th><th>Time</th><th>Price</th><th>Difficulty</th><th>Options</th>";

            table.appendChild(headerRow);

            recipes.forEach((recipe) => {
              const row = document.createElement("tr");
              row.innerHTML = `<td>${recipe.id}</td><td>${recipe.title}</td><td>${recipe.author}</td><td>${recipe.ingredients}</td><td>${recipe.preparation}</td><td>${recipe.category}</td><td>${recipe.time}</td><td>${recipe.price}</td><td>${recipe.difficulty}</td><td><a class="newButton" href="">View</a></td>`;
              table.appendChild(row);
            });

            tableContainer.appendChild(table);
          } else {
            tableContainer.innerHTML = "Nenhum usuário encontrado.";
          }
        }

        function openNav() {
          document.getElementById("mySidenav").style.width = "300px";
          document.getElementById("overlay").style.display = "block";
          document.getElementById("nav").style.backgroundColor =
            "rgba(0,0,0,0.4)";
        }

        function closeNav() {
          document.getElementById("mySidenav").style.width = "0";
          document.getElementById("overlay").style.display = "none";
          document.getElementById("nav").style.backgroundColor = "#fff";
        }
      </script>

    </body>
  </html>
</html>
