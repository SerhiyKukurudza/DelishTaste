<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
      integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/index_style.css" />
  </head>

    <body>
      <nav>
        <img class="logo" src="/images/mainLogo.png" />
        <ul>
          <li><a href="/">Home</a></li>
          {{#user}}
          <li><a href="/profile">Profile</a></li>
              {{#isAdmin}}
              <li><a href="/backEnd">BackEnd</a></li>
              {{/isAdmin}}
              {{^isAdmin}}

              {{/isAdmin}}
          <li><a href="/auth/checkData">Check data user</a></li>
          <li><a href="/auth/logout">Logout</a></li>
          {{/user}}
          {{^user}}
          <li><a href="/login">Login</a></li>
          <li><a href="/auth/checkData">Check data user</a></li>
          <li><a href="/signUp">Sign Up</a></li>
          {{/user}}
        </ul>
      </nav>

    <div class="homeImg">
      <h1 class="textTop">Choose from thousands of recipes</h1>
      <p class="textMiddle">
        Appropriately integrate technically sound value with scalable
        infomediaries negotiate sustainable strategic theme areas
      </p>
      <a class="textBottom" href="/register">Sign up today</a>
    </div>
    <div class="container mt-4">
      <!-- Recipe Section -->
      <div class="jumbotron" id="recipeJumbotron">
        <div class="card" id="recipeCard">
          <div class="card-body">
            <!-- Os dados serão preenchidos aqui -->
          </div>
        </div>
      </div>
      <!-- End Recipe Section -->
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        console.log('DOM fully loaded. Fetching recipes...');

        fetch("/api/recipes") // Substitua pela sua rota real
          .then(response => response.json())
          .then(data => {
            const recipes = data;
            const recipeCard = document.getElementById('recipeCard');
            const cardBody = recipeCard.querySelector('.card-body');

            if (recipes && recipes.length > 0) {
              // Exemplo: Acesse o título da primeira receita
              // alert(recipes[0].title);
              console.log(recipes);
              console.log('Recipes available. Displaying...');

              // Renderizar os dados no HTML
              cardBody.innerHTML = `
                <h5 class="card-title">${recipes[0].title}</h5>
                <p class="card-text">Author: ${recipes[0].author}</p>
              `;
            } else {
              console.log('No recipes available.');
              cardBody.innerHTML = '<h5 class="card-title">No recipes available</h5>';
            }
          })
          .catch(error => {
            console.error('Error fetching recipes:', error);
          });
      });
    </script>
  </body>
</html>
