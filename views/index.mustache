<!DOCTYPE html>
<html lang="en">
  <html>
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Home Page</title>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
        integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm"
        crossorigin="anonymous"
      />
      <link rel="stylesheet" href="/css/index_style.css" />
    </head>

    <body>
      <nav>
        <img class="logo" src="/images/mainLogo.png" />
        <ul>
          <li><a href="/">Home</a></li>
          {{#user}}
          <li><a href="/profile">Profile</a></li>
          <li><a href="/auth/logout">Logout</a></li>
          {{/user}}
          {{^user}}
          <li><a href="/login">Login</a></li>
          <li><a href="/signUp">Sign Up</a></li>
          {{/user}}
        </ul>
      </nav>

      <div class="homeImg">
        <h1 class="textTop">Choose from thousands of recipes</h1>
        <p class="textMiddle">
          Appropriately integrate technically sound value with scalable
          infomediaries negotiate sustainable strategic theme areas
        </p>
        <a class="textBottom" href="/register">Sign up today</a>
      </div>

      <div class="container mt-4">
        <div class="jumbotron">
          <h1 class="display-4">Login Project</h1>
          <p class="lead">
            This is a simple hero unit, a simple jumbotron-style component for
            calling extra attention to featured content or information.
          </p>
          <hr class="my-4" />
          <p>
            It uses utility classes for typography and spacing to space content
            out within the larger container.
          </p>
          <p class="lead">
            <a class="btn btn-primary btn-lg" href="#" role="button"
              >Learn more</a
            >
          </p>
        </div>
      </div>

      <script
        src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
        integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
        crossorigin="anonymous"
      ></script>
    </body>
  </html>
</html>
