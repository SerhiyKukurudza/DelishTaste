<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    <link rel="icon" type="image/png" href="/images/mainLogoTitleBar.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
      integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" type="text/css" href="/css/login_style.css" />
  </head>

  <body>
    <div class="mainContainer">
      <div class="emptySpace">
        <div class="container">
          
          <a href="/"><img class="logo" src="/images/mainLogo.png"/></a>

          <form action="/auth/login" method="POST">
            <div class="form-group">
              <label for="email">Email Address</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                placeholder="Enter Email Address"
              />
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Enter Password"
              />
              <br />
              <input type="checkbox" onclick="showPass()" /> Show Password
            </div>
            <button type="submit">Log In</button>
          </form>
          <br>
          <p>No account yet? <a href="/signUp" style="color: #E97D3F;">Sign up</a></p>
          {{#message}}
          <h4 class="alert alert-danger mt-4">{{ message }}</h4>
          {{/message}}
        </div>
      </div>

      <div class="loginImg">
        <div class="shade">
          <h1 class="textTop">Welcome back!</h1>
          <p class="textMiddle">
            Ready to dive into the world of flavors? Log in now explore
            mouthwatering recipes, Let's Cook!
          </p>
          <a class="textBottom" href="/signUp">Sign up today -></a>
        </div>
      </div>
    </div>

    <script
      src="https://code.jquery.com/jquery-3.4.1.slim.min.js"
      integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n"
      crossorigin="anonymous"
    ></script>

    <script>
      function showPass() {
        var password = document.getElementById("password");
        if (password.type === "password") {
          password.type = "text";
        } else {
          password.type = "password";
        }
      }
    </script>
  </body>
</html>
