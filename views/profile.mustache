<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <link rel="icon" type="image/png" href="/images/mainLogoTitleBar.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css"
      integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm"
      crossorigin="anonymous"
    />
    <script
      src="https://kit.fontawesome.com/4e13ac108a.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="/css/profile_style.css" />
  </head>

  <body>
    <nav>
      <a href="/"><img class="logo" src="/images/mainLogo.png" /></a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/profile">Profile</a></li>
        {{#isAdmin}}
        <li><a href="/backEnd">BackEnd</a></li>
        {{/isAdmin}}
        <li><a href="/auth/logout">Logout</a></li>
      </ul>
    </nav>

    <div class="profile">
      <div class="col-3.5">
        <div class="card">
          <div class="avatar-ctn">
            <img
              src="/images/avatar.png"
              class="avatar"
              alt="user profile picture"
            />
          </div>
          <div class="card-body">
            <h6 class="card-title">Username: {{ user.name }}</h6>
            <h6 class="card-title">Email: {{ user.email }}</h6>
          </div>
        </div>
      </div>

      <div class="profileOptions">
        <div class="sidebar">
          <a onclick="profileFragment()"
            ><i class="fa-solid fa-user"></i>Profile</a
          >
          <a onclick="personalDetailsFragment()"
            ><i class="fa-solid fa-address-book"></i>Personal details</a
          >
          <a onclick="changePasswordFragment()"
            ><i class="fa-solid fa-key"></i>Change password</a
          >
        </div>

        <div class="info">
          <div
            id="profileFragment"
            style="display: {{#showProfileFragment}}block{{/showProfileFragment}}{{^showProfileFragment}}none{{/showProfileFragment}};"
          >
            <h5 class="card-title">Welcome Back {{ user.name }}!</h5>
            <p class="card-text">
              This is your profile page, where you can edit account details,
              such as personal information and change your password.
            </p>
          </div>

          <div
            id="personalDetailsFragment"
            style="display: {{#personalDetailsFragment}}block{{/personalDetailsFragment}}{{^personalDetailsFragment}}none{{/personalDetailsFragment}};"
          >
            <h5 class="card-title">Personal details</h5>
            <p class="card-text">
              On this tab, you have the ability to change personal information.
            </p>

            <div class="personalDetailsForm">
              <form action="/profile/updatePersonalDetails" method="POST">
                <div class="form-group">
                  <label for="name">Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="name"
                    placeholder="Enter name"
                    value="{{ user.name }}"
                  />
                </div>
                <div class="form-group">
                  <label for="email">Email Address</label>
                  <input
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    placeholder="Enter Email Address"
                    value="{{ user.email }}"
                  />
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
              </form>
              {{#message}}
              <h4 class="alert alert-danger mt-4">{{ message }}</h4>
              {{/message}}
            </div>
          </div>

          <div
            id="changePasswordFragment"
            style="display: {{#changePasswordFragment}}block{{/changePasswordFragment}}{{^changePasswordFragment}}none{{/changePasswordFragment}};"
          >
            <h5 class="card-title">Change password</h5>
            <p class="card-text">
              On this tab, you have the ability to change your password.
            </p>

            <div class="changePasswordForm">
              <form action="/profile/updatePassword" method="POST">
                <div class="form-group">
                  <label for="currentPassword">Current Password</label>
                  <input
                    type="password"
                    class="form-control"
                    id="currentPassword"
                    name="currentPassword"
                    placeholder="Enter Password"
                  />
                </div>
                <div class="form-group">
                  <label for="password">New Password</label>
                  <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    placeholder="Enter Password"
                  />
                </div>
                <div class="form-group">
                  <label for="passwordConfirm">Confirm Password</label>
                  <input
                    type="password"
                    class="form-control"
                    id="passwordConfirm"
                    name="passwordConfirm"
                    placeholder="Confirm Password"
                  />
                  <br />
                  <input type="checkbox" onclick="showPass()" /> Show Passwords
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
              </form>
              {{#message}}
              <h4 class="alert alert-danger mt-3">{{ message }}</h4>
              {{/message}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <script
      src="https://code.jquery.com/jquery-3.4.1.slim.min.js"
      integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n"
      crossorigin="anonymous"
    ></script>

    <script>
      function profileFragment() {
        document.getElementById("profileFragment").style.display = "block";
        document.getElementById("personalDetailsFragment").style.display =
          "none";
        document.getElementById("changePasswordFragment").style.display =
          "none";
      }

      function personalDetailsFragment() {
        document.getElementById("profileFragment").style.display = "none";
        document.getElementById("personalDetailsFragment").style.display =
          "block";
        document.getElementById("changePasswordFragment").style.display =
          "none";
      }

      function changePasswordFragment() {
        document.getElementById("profileFragment").style.display = "none";
        document.getElementById("personalDetailsFragment").style.display =
          "none";
        document.getElementById("changePasswordFragment").style.display =
          "block";
      }

      function showPass() {
        var currentPassword = document.getElementById("currentPassword");
        var password = document.getElementById("password");
        var passwordConfirm = document.getElementById("passwordConfirm");
        if (
          currentPassword.type &&
          password.type &&
          passwordConfirm.type === "password"
        ) {
          currentPassword.type = "text";
          password.type = "text";
          passwordConfirm.type = "text";
        } else {
          currentPassword.type = "password";
          password.type = "password";
          passwordConfirm.type = "password";
        }
      }

      function showEditForm() {
        var divEditForm = document.getElementById("editForm");
        var editBtn = document.getElementById("editBtn");
        divEditForm.style.display = "block";
        editBtn.style.display = "none";
      }
    </script>

    <footer>
      <p>&copy; 2024 Made by Serhiy Kukurudza and Bruno Rosa</p>
    </footer>
  </body>
</html>
